# ── Clerk ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
#
# IMPORTANT — Clerk Dashboard setup required:
#   1. Dashboard → Domains → add sso.example.com as your primary domain
#   2. Dashboard → Paths → set "Sign-in URL" to /sign-in
#   3. Dashboard → Allowed redirect URLs → add https://sso.example.com/api/auth/callback
#      and any service domains you want to redirect back to after login

# Clerk built-in redirect paths (must match sign-in page route)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ── Custom SSO JWT ────────────────────────────────────────────────────────────
# Strong random secret: openssl rand -base64 48
JWT_SECRET=

# Root domain WITHOUT leading dot — e.g. example.com
# The cookie will be set on .example.com so all subdomains share it.
COOKIE_DOMAIN=example.com

# Hostname of the SSO service itself — e.g. sso.example.com
SSO_HOST=sso.example.com

# Comma-separated list of domains allowed as redirect targets after login.
# Include your root domain; subdomains are matched automatically.
# e.g. example.com,another-domain.com
ALLOWED_REDIRECT_HOSTS=example.com

# ── nginx shared secret ───────────────────────────────────────────────────────
# Any random string — must match X-Internal-Secret in nginx config.
# openssl rand -hex 32
INTERNAL_SECRET=
